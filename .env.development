# Adres backendu ZUS baby dla `expo start` (lokalnie: Spring Boot z baby-zus-backend).
# Wersja web na TEST i PROD bierze adres z /config.json (zmienna API_URL kontenera, patrz nginx/default.conf.template).
# Własny adres bez commitowania: utwórz .env.development.local (jest w .gitignore).
EXPO_PUBLIC_API_URL=http://localhost:8080
