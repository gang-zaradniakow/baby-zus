# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore – klucze nigdy do repozytorium.

# --- LLM (wymienny przez konfigurację, ZUS-50) ---
# openai_compatible = dowolny serwer z API zgodnym z OpenAI; fake = testy
# Kandydat z ADR 0002: OVHcloud AI Endpoints + Olala mini (wartości ostateczne po ZUS-05).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
LLM_MODEL=Olala-v1.0-mini-7A1B
# Puste LLM_API_KEY = tryb anonimowy (OVH pozwala, niższe limity).
LLM_API_KEY=
# none | minimal | low | medium | high | max; puste = domyślny serwera
LLM_REASONING_EFFORT=low
# true – response_format=json_schema; false – schemat w prompcie (modele bez tej funkcji)
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_S=20
LLM_MAX_ATTEMPTS=3
# Embeddingi (RAG, ZUS-35): puste EMBEDDING_MODEL = atrapa (fake) bez sieci.
# Adres i klucz domyślnie jak dla LLM; inaczej EMBEDDING_BASE_URL / EMBEDDING_API_KEY.
EMBEDDING_MODEL=
# Zapasowo (Bielik, po odblokowaniu Sherlocka):
# LLM_BASE_URL=https://api-sherlock.cloudferro.com/openai/v1
# LLM_MODEL=speakleash/Bielik-11B-v3.0-Instruct

# --- Źródło profilu (ZUS-30): mock | http ---
# http: backend innego zespołu wg docs/contracts/backend-profile.openapi.json
PROFILE_SOURCE=mock
BACKEND_URL=
BACKEND_API_KEY=
BACKEND_TIMEOUT_S=5
BACKEND_MAX_ATTEMPTS=3
# mock: persony T01–T12 (klucz = profileId, np. persona-t01)
PERSONAS_DIR=data/personas

# --- Baza danych (ZUS-02 / ZUS-40) ---
# docker compose: Postgres 17 + pgvector; w kontenerze api adres bazy ustawia compose.yaml.
POSTGRES_USER=zus
POSTGRES_PASSWORD=zus
POSTGRES_DB=zus
DB_PORT=5432
API_PORT=8000
# Uruchomienie API poza Dockerem (baza z compose na localhost):
DATABASE_URL=postgresql+asyncpg://zus:zus@localhost:5432/zus

# --- Serwery MCP (ZUS-32) ---
# Wspólny sekret API i serwerów MCP do podpisu tokenów dostępu (min. 16 znaków, losowy).
MCP_TOKEN_SECRET=zmien-mnie-na-losowy-sekret
# Dozwolone nagłówki Host serwerów MCP (JSON); w compose usługa nazywa się mcp_servers.
# MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","mcp_servers:*"]
# Baza wiedzy (serwer wiedza, ZUS-35): memory – korpus wczytywany przy starcie;
# pgvector – tabela knowledge_chunks wypełniona przez: python -m assistant.rag.ingest
KNOWLEDGE_INDEX=memory
KNOWLEDGE_DIR=data/knowledge

# --- Sesje API (ZUS-41) ---
# Ważność tokenu sesji (logowanie symulowane mObywatel i tryb bez logowania).
SESSION_TTL_MINUTES=60
