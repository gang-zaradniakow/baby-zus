{
  "server": "profil",
  "instructions": "Profil zalogowanego użytkownika: etap, dziecko, zdarzenia, plan urlopu.",
  "tools": [
    {
      "name": "get_partner_profile",
      "description": "Dane drugiego rodzica – tylko gdy wyraził zgodę (inaczej CONSENT_REQUIRED).",
      "inputSchema": {
        "properties": {
          "user_ref": {
            "title": "User Ref",
            "type": "string"
          }
        },
        "required": [
          "user_ref"
        ],
        "title": "get_partner_profileArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "EmploymentEndReason": {
            "enum": [
              "BANKRUPTCY",
              "LIQUIDATION",
              "EMPLOYER_DEATH",
              "COURT_RULING",
              "CONTRACT_EXPIRY",
              "OTHER"
            ],
            "title": "EmploymentEndReason",
            "type": "string"
          },
          "FactSource": {
            "description": "Skąd pochodzi fakt: pobrany z ZUS, wpisany przez użytkownika, odczytany z dokumentu.",
            "enum": [
              "ZUS",
              "USER",
              "DOCUMENT"
            ],
            "title": "FactSource",
            "type": "string"
          },
          "InsurancePeriod": {
            "additionalProperties": false,
            "description": "Okres podlegania ubezpieczeniu z jednego tytułu.",
            "properties": {
              "title": {
                "$ref": "#/$defs/InsuranceTitle"
              },
              "sickness": {
                "$ref": "#/$defs/SicknessInsurance"
              },
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Dateto"
              },
              "endReason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EmploymentEndReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "title",
              "sickness",
              "dateFrom"
            ],
            "title": "InsurancePeriod",
            "type": "object"
          },
          "InsuranceProfile": {
            "additionalProperties": false,
            "description": "Dane ubezpieczeniowe jednego rodzica (pobrane z ZUS albo wpisane w formularzu).",
            "properties": {
              "source": {
                "$ref": "#/$defs/FactSource"
              },
              "periods": {
                "items": {
                  "$ref": "#/$defs/InsurancePeriod"
                },
                "title": "Periods",
                "type": "array"
              },
              "payer": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PayerInfo"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "salaries": {
                "items": {
                  "$ref": "#/$defs/MonthlySalary"
                },
                "title": "Salaries",
                "type": "array"
              },
              "deductionRate": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Procent potrąconych składek ze sprawy (U7); brak → wartość domyślna z parametrów.",
                "title": "Deductionrate"
              },
              "contributionDebt": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Contributiondebt"
              },
              "sickLeaves": {
                "items": {
                  "$ref": "#/$defs/SickLeave"
                },
                "title": "Sickleaves",
                "type": "array"
              }
            },
            "required": [
              "source"
            ],
            "title": "InsuranceProfile",
            "type": "object"
          },
          "InsuranceTitle": {
            "enum": [
              "EMPLOYMENT",
              "MANDATE_CONTRACT",
              "BUSINESS"
            ],
            "title": "InsuranceTitle",
            "type": "string"
          },
          "MonthlySalary": {
            "additionalProperties": false,
            "description": "Przychód brutto za miesiąc (podstawa wymiaru liczona w silniku, ZUS-12).",
            "properties": {
              "month": {
                "examples": [
                  "2026-03"
                ],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "title": "Month",
                "type": "string"
              },
              "gross": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "title": "Gross"
              }
            },
            "required": [
              "month",
              "gross"
            ],
            "title": "MonthlySalary",
            "type": "object"
          },
          "ParentRole": {
            "enum": [
              "MOTHER",
              "FATHER"
            ],
            "title": "ParentRole",
            "type": "string"
          },
          "PayerInfo": {
            "additionalProperties": false,
            "description": "Liczba ubezpieczonych u płatnika – decyduje, kto wypłaca zasiłek (art. 61).",
            "properties": {
              "insuredCountNov30": {
                "minimum": 0,
                "title": "Insuredcountnov30",
                "type": "integer"
              },
              "countDate": {
                "format": "date",
                "title": "Countdate",
                "type": "string"
              }
            },
            "required": [
              "insuredCountNov30",
              "countDate"
            ],
            "title": "PayerInfo",
            "type": "object"
          },
          "SickLeave": {
            "additionalProperties": false,
            "description": "Zwolnienie lekarskie e-ZLA.",
            "properties": {
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "format": "date",
                "title": "Dateto",
                "type": "string"
              },
              "code": {
                "anyOf": [
                  {
                    "pattern": "^[A-E]$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Code"
              }
            },
            "required": [
              "dateFrom",
              "dateTo"
            ],
            "title": "SickLeave",
            "type": "object"
          },
          "SicknessInsurance": {
            "enum": [
              "MANDATORY",
              "VOLUNTARY",
              "NONE"
            ],
            "title": "SicknessInsurance",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/$defs/ParentRole"
          },
          "birthDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Potrzebna tylko do progu 50 lat (wynagrodzenie chorobowe 14 zamiast 33 dni).",
            "title": "Birthdate"
          },
          "insurance": {
            "$ref": "#/$defs/InsuranceProfile"
          }
        },
        "required": [
          "role",
          "insurance"
        ],
        "title": "ParentProfile",
        "type": "object"
      }
    },
    {
      "name": "get_profile",
      "description": "Profil sprawy (dziecko, PDP, liczba dzieci, zdarzenia) z etapem E0–E3 i flagami.",
      "inputSchema": {
        "properties": {
          "user_ref": {
            "title": "User Ref",
            "type": "string"
          }
        },
        "required": [
          "user_ref"
        ],
        "title": "get_profileArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "ChildInfo": {
            "additionalProperties": false,
            "description": "Dane ciąży lub dziecka. Wszystkie daty opcjonalne – brak oznacza NEED_INFO.",
            "properties": {
              "source": {
                "$ref": "#/$defs/FactSource"
              },
              "expectedBirthDate": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Expectedbirthdate"
              },
              "birthDate": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Birthdate"
              },
              "childrenCount": {
                "default": 1,
                "maximum": 10,
                "minimum": 1,
                "title": "Childrencount",
                "type": "integer"
              },
              "zaZyciem": {
                "default": false,
                "title": "Zazyciem",
                "type": "boolean"
              },
              "gestationalWeeks": {
                "anyOf": [
                  {
                    "maximum": 45,
                    "minimum": 20,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Ukończone tygodnie ciąży w dniu porodu (urlop uzupełniający, ZUS-18).",
                "title": "Gestationalweeks"
              },
              "birthWeightG": {
                "anyOf": [
                  {
                    "maximum": 7000,
                    "minimum": 200,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Masa urodzeniowa w gramach; przy porodzie mnogim – najmniejsza z mas dzieci.",
                "title": "Birthweightg"
              },
              "placement": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Placement"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "source"
            ],
            "title": "ChildInfo",
            "type": "object"
          },
          "EmploymentEndReason": {
            "enum": [
              "BANKRUPTCY",
              "LIQUIDATION",
              "EMPLOYER_DEATH",
              "COURT_RULING",
              "CONTRACT_EXPIRY",
              "OTHER"
            ],
            "title": "EmploymentEndReason",
            "type": "string"
          },
          "FactSource": {
            "description": "Skąd pochodzi fakt: pobrany z ZUS, wpisany przez użytkownika, odczytany z dokumentu.",
            "enum": [
              "ZUS",
              "USER",
              "DOCUMENT"
            ],
            "title": "FactSource",
            "type": "string"
          },
          "Flag": {
            "description": "Flagi nakładane na etap (ustalenie U3).",
            "enum": [
              "ADOPTION",
              "DIFFICULT"
            ],
            "title": "Flag",
            "type": "string"
          },
          "InsurancePeriod": {
            "additionalProperties": false,
            "description": "Okres podlegania ubezpieczeniu z jednego tytułu.",
            "properties": {
              "title": {
                "$ref": "#/$defs/InsuranceTitle"
              },
              "sickness": {
                "$ref": "#/$defs/SicknessInsurance"
              },
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Dateto"
              },
              "endReason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EmploymentEndReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "title",
              "sickness",
              "dateFrom"
            ],
            "title": "InsurancePeriod",
            "type": "object"
          },
          "InsuranceProfile": {
            "additionalProperties": false,
            "description": "Dane ubezpieczeniowe jednego rodzica (pobrane z ZUS albo wpisane w formularzu).",
            "properties": {
              "source": {
                "$ref": "#/$defs/FactSource"
              },
              "periods": {
                "items": {
                  "$ref": "#/$defs/InsurancePeriod"
                },
                "title": "Periods",
                "type": "array"
              },
              "payer": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PayerInfo"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "salaries": {
                "items": {
                  "$ref": "#/$defs/MonthlySalary"
                },
                "title": "Salaries",
                "type": "array"
              },
              "deductionRate": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Procent potrąconych składek ze sprawy (U7); brak → wartość domyślna z parametrów.",
                "title": "Deductionrate"
              },
              "contributionDebt": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Contributiondebt"
              },
              "sickLeaves": {
                "items": {
                  "$ref": "#/$defs/SickLeave"
                },
                "title": "Sickleaves",
                "type": "array"
              }
            },
            "required": [
              "source"
            ],
            "title": "InsuranceProfile",
            "type": "object"
          },
          "InsuranceTitle": {
            "enum": [
              "EMPLOYMENT",
              "MANDATE_CONTRACT",
              "BUSINESS"
            ],
            "title": "InsuranceTitle",
            "type": "string"
          },
          "LeavePart": {
            "additionalProperties": false,
            "description": "Część planowanego urlopu (podział między rodziców, łączenie z pracą).",
            "properties": {
              "parent": {
                "$ref": "#/$defs/ParentRole"
              },
              "type": {
                "$ref": "#/$defs/PeriodType"
              },
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "format": "date",
                "title": "Dateto",
                "type": "string"
              },
              "workFraction": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "default": "0",
                "description": "Wymiar pracy w trakcie tej części urlopu (0 = bez pracy, maks. 0.5 sprawdza silnik).",
                "title": "Workfraction"
              }
            },
            "required": [
              "parent",
              "type",
              "dateFrom",
              "dateTo"
            ],
            "title": "LeavePart",
            "type": "object"
          },
          "MonthlySalary": {
            "additionalProperties": false,
            "description": "Przychód brutto za miesiąc (podstawa wymiaru liczona w silniku, ZUS-12).",
            "properties": {
              "month": {
                "examples": [
                  "2026-03"
                ],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "title": "Month",
                "type": "string"
              },
              "gross": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "title": "Gross"
              }
            },
            "required": [
              "month",
              "gross"
            ],
            "title": "MonthlySalary",
            "type": "object"
          },
          "ParentProfile": {
            "additionalProperties": false,
            "properties": {
              "role": {
                "$ref": "#/$defs/ParentRole"
              },
              "birthDate": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Potrzebna tylko do progu 50 lat (wynagrodzenie chorobowe 14 zamiast 33 dni).",
                "title": "Birthdate"
              },
              "insurance": {
                "$ref": "#/$defs/InsuranceProfile"
              }
            },
            "required": [
              "role",
              "insurance"
            ],
            "title": "ParentProfile",
            "type": "object"
          },
          "ParentRole": {
            "enum": [
              "MOTHER",
              "FATHER"
            ],
            "title": "ParentRole",
            "type": "string"
          },
          "PayerInfo": {
            "additionalProperties": false,
            "description": "Liczba ubezpieczonych u płatnika – decyduje, kto wypłaca zasiłek (art. 61).",
            "properties": {
              "insuredCountNov30": {
                "minimum": 0,
                "title": "Insuredcountnov30",
                "type": "integer"
              },
              "countDate": {
                "format": "date",
                "title": "Countdate",
                "type": "string"
              }
            },
            "required": [
              "insuredCountNov30",
              "countDate"
            ],
            "title": "PayerInfo",
            "type": "object"
          },
          "PeriodType": {
            "description": "Rodzaj świadczenia w okresie wyliczenia albo w planie urlopu.",
            "enum": [
              "MACIERZYNSKI",
              "NA_WARUNKACH_MACIERZYNSKIEGO",
              "UZUPELNIAJACY_MACIERZYNSKI",
              "RODZICIELSKI",
              "OJCOWSKI",
              "CHOROBOWY",
              "W_WYSOKOSCI_MACIERZYNSKIEGO",
              "OPIEKUNCZY",
              "SWIADCZENIE_REHABILITACYJNE"
            ],
            "title": "PeriodType",
            "type": "string"
          },
          "Placement": {
            "additionalProperties": false,
            "description": "Przyjęcie dziecka na wychowanie: przysposobienie albo rodzina zastępcza (E4 → flaga).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/PlacementKind"
              },
              "childBirthDate": {
                "format": "date",
                "title": "Childbirthdate",
                "type": "string"
              },
              "placementDate": {
                "format": "date",
                "title": "Placementdate",
                "type": "string"
              },
              "rulingFinalDate": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Rulingfinaldate"
              },
              "schoolDeferral": {
                "default": false,
                "title": "Schooldeferral",
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "childBirthDate",
              "placementDate"
            ],
            "title": "Placement",
            "type": "object"
          },
          "PlacementKind": {
            "enum": [
              "ADOPTION",
              "FOSTER_FAMILY"
            ],
            "title": "PlacementKind",
            "type": "string"
          },
          "Profile": {
            "additionalProperties": false,
            "description": "Kompletny kontekst sprawy przekazywany do silnika reguł.",
            "properties": {
              "profileId": {
                "description": "Pseudonimowy identyfikator – nigdy PESEL.",
                "minLength": 1,
                "title": "Profileid",
                "type": "string"
              },
              "applicant": {
                "$ref": "#/$defs/ParentProfile"
              },
              "partner": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ParentProfile"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "partnerConsent": {
                "default": false,
                "title": "Partnerconsent",
                "type": "boolean"
              },
              "child": {
                "$ref": "#/$defs/ChildInfo"
              },
              "specialEvents": {
                "items": {
                  "$ref": "#/$defs/SpecialEvent"
                },
                "title": "Specialevents",
                "type": "array"
              },
              "leavePlan": {
                "items": {
                  "$ref": "#/$defs/LeavePart"
                },
                "title": "Leaveplan",
                "type": "array"
              }
            },
            "required": [
              "profileId",
              "applicant",
              "child"
            ],
            "title": "Profile",
            "type": "object"
          },
          "SickLeave": {
            "additionalProperties": false,
            "description": "Zwolnienie lekarskie e-ZLA.",
            "properties": {
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "format": "date",
                "title": "Dateto",
                "type": "string"
              },
              "code": {
                "anyOf": [
                  {
                    "pattern": "^[A-E]$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Code"
              }
            },
            "required": [
              "dateFrom",
              "dateTo"
            ],
            "title": "SickLeave",
            "type": "object"
          },
          "SicknessInsurance": {
            "enum": [
              "MANDATORY",
              "VOLUNTARY",
              "NONE"
            ],
            "title": "SicknessInsurance",
            "type": "string"
          },
          "SpecialEvent": {
            "additionalProperties": false,
            "description": "Zdarzenie szczególne (§3.1 E5, kategoria F): hospitalizacja, zgon, wcześniak itp.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/SpecialEventKind"
              },
              "dateFrom": {
                "format": "date",
                "title": "Datefrom",
                "type": "string"
              },
              "dateTo": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Dateto"
              }
            },
            "required": [
              "kind",
              "dateFrom"
            ],
            "title": "SpecialEvent",
            "type": "object"
          },
          "SpecialEventKind": {
            "enum": [
              "MISCARRIAGE",
              "STILLBIRTH",
              "CHILD_DEATH",
              "PREMATURE_BIRTH",
              "CHILD_HOSPITALIZATION",
              "MOTHER_HOSPITALIZATION",
              "MOTHER_UNABLE_TO_CARE",
              "MOTHER_DEATH",
              "CHILD_ABANDONMENT"
            ],
            "title": "SpecialEventKind",
            "type": "string"
          },
          "Stage": {
            "description": "Etap ścieżki rodzica (ustalenie U3).",
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3"
            ],
            "title": "Stage",
            "type": "string"
          },
          "StageInfo": {
            "additionalProperties": false,
